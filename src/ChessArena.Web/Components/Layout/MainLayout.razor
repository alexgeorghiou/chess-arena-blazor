@inherits LayoutComponentBase
@implements IDisposable
@inject PlayerSession Session

<header class="topbar">
    <a class="brand" href="/">&#9822; ChessArena</a>
    <nav>
        <NavLink href="/" Match="NavLinkMatch.All">Lobby</NavLink>
        <NavLink href="/games">Games</NavLink>
    </nav>
    <div class="who">
        @if (Session.Current is { } me)
        {
            <span class="handle">@me.Handle</span>
            <span class="rating">@me.Rating</span>
            <button class="link" @onclick="Session.SignOutAsync">Sign out</button>
        }
    </div>
</header>

<main class="content">
    @Body
</main>

<div id="blazor-error-ui">
    Connection lost or an error occurred.
    <a href="" class="reload">Reload</a>
</div>

@code {
    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Session.RestoreAsync();
        }
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
